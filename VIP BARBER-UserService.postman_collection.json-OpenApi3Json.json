{
  "openapi": "3.0.0",
  "info": {
    "title": "User Service",
    "version": "1.0"
  },
  "paths": {
    "/users": {
      "post": {
        "tags": ["USER-SERVICE"],
        "summary": "Buat User",
        "operationId": "BuatUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BuatUserRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Sukses" }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": ["USER-SERVICE"],
        "summary": "Cek User",
        "operationId": "CekUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/sukses1" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BuatUserRequest": {
        "type": "object",
        "required": ["name", "email", "password", "vip"],
        "properties": {
          "name": { "type": "integer" },
          "email": { "type": "string" },
          "password": { "type": "string" },
          "vip": { "type": "boolean" }
        }
      },
      "Sukses": {
        "type": "object",
        "required": ["name", "email", "updated_at", "created_at", "id"],
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string" },
          "updated_at": { "type": "string" },
          "created_at": { "type": "string" },
          "id": { "type": "integer" }
        }
      },
      "sukses1": {
        "type": "object",
        "required": ["id", "name", "email", "vip", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "vip": { "type": "integer" },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      }
    }
  }
}
