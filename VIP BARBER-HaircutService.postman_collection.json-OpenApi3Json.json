{
  "openapi": "3.0.0",
  "info": {
    "title": "Haircut Service",
    "version": "1.0"
  },
  "paths": {
    "/haircuts": {
      "post": {
        "tags": ["HairCuts-Service"],
        "summary": "Create Haircut",
        "operationId": "Create",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Sukses2" }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Gagal3" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateRequest": {
        "type": "object",
        "required": ["name", "description", "price"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "price": { "type": "integer" }
        }
      },
      "Sukses2": {
        "type": "object",
        "required": ["name", "description", "price", "updated_at", "created_at", "id"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "price": { "type": "integer" },
          "updated_at": { "type": "string" },
          "created_at": { "type": "string" },
          "id": { "type": "integer" }
        }
      },
      "Gagal3": {
        "type": "object",
        "required": ["message", "error"],
        "properties": {
          "message": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    }
  }
}
